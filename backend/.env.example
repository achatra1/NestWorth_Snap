# Application Environment
APP_ENV=development
PORT=8000

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nestworth?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-characters-long-change-this-in-production
JWT_EXPIRES_IN=86400

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:5137

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Resend (transactional email for password reset). Leave blank to fall back
# to logging the reset link (and, in development, returning it in the API
# response) instead of sending an email.
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=NestWorth <onboarding@resend.dev>

# Base URL of the deployed frontend, used to build links embedded in emails
FRONTEND_URL=http://localhost:5137